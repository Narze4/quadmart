rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function campus() {
      let email = request.auth.token.email.lower();
      return email.matches('.*@([a-z0-9-]+[.])*emory[.]edu') ? 'emory.edu'
        : email.matches('.*@([a-z0-9-]+[.])*uga[.]edu') ? 'uga.edu'
        : email.matches('.*@([a-z0-9-]+[.])*gatech[.]edu') ? 'gatech.edu'
        : email.matches('.*@([a-z0-9-]+[.])*scad[.]edu') ? 'scad.edu'
        : email.matches('.*@([a-z0-9-]+[.])*gsu[.]edu') ? 'gsu.edu'
        : email.matches('.*@([a-z0-9-]+[.])*kennesaw[.]edu') ? 'kennesaw.edu'
        : email.matches('.*@([a-z0-9-]+[.])*utk[.]edu') ? 'utk.edu' : '';
    }
    function student() {
      return signedIn() && request.auth.token.email_verified == true && campus() != ''
        && (!exists(/databases/$(database)/documents/moderationAccounts/$(request.auth.uid))
          || get(/databases/$(database)/documents/moderationAccounts/$(request.auth.uid)).data.suspended != true);
    }
    function member(conversationId) {
      return student() && request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }
    function shortText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }

    // Private account data, including saved listings. Provisioned by trusted backend.
    match /users/{uid} {
      allow get: if student() && request.auth.uid == uid;
      allow update: if student() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'savedListings'])
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('displayName', '').size() <= 80
        && request.resource.data.get('savedListings', []) is list
        && request.resource.data.get('savedListings', []).size() <= 200;
      // Legacy reviews are denied; transaction-validated reviews use publicProfiles.
      match /reviews/{reviewId} { allow read, write: if false; }
    }
    // Public-facing fields must be explicitly projected by the trusted backend.
    match /publicProfiles/{uid} {
      allow read: if student() && resource.data.campusId == campus();
      allow write: if false;
      match /reviews/{reviewId} {
        allow read: if student() && resource.data.campusId == campus();
        allow write: if false;
      }
    }
    match /listings/{listingId} {
      function validListing(d) {
        return d.keys().hasAll(['title','description','price','category','condition','images','sellerUid','sellerEmail','campusId','status','createdAt'])
          && d.keys().hasOnly(['title','description','price','category','condition','images','sellerUid','sellerEmail','campusId','status','createdAt','imageIds'])
          && shortText(d.title, 120) && d.description is string && d.description.size() <= 5000
          && d.price is number && d.price >= 0 && d.price <= 100000
          && d.category in ['Product','Service','Sublease']
          && d.condition in ['New','Like New','Good','Fair']
          && d.images is list && d.images.size() <= 5
          && d.get('imageIds', []) is list && d.get('imageIds', []).size() == d.images.size()
          && (d.images.size() < 1 || ownedImage(d, 0))
          && (d.images.size() < 2 || ownedImage(d, 1))
          && (d.images.size() < 3 || ownedImage(d, 2))
          && (d.images.size() < 4 || ownedImage(d, 3))
          && (d.images.size() < 5 || ownedImage(d, 4));
      }
      function ownedImage(d, index) {
        let mediaId = d.imageIds[index];
        let asset = get(/databases/$(database)/documents/media/$(mediaId)).data;
        return mediaId is string && mediaId.matches('[a-f0-9]{64}')
          && asset.status == 'ready' && asset.ownerUid == request.auth.uid
          && asset.campusId == campus() && asset.url == d.images[index];
      }
      allow read: if student() && resource.data.campusId == campus();
      allow create: if student() && !exists(/databases/$(database)/documents/removedListings/$(listingId)) && validListing(request.resource.data)
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.sellerEmail == request.auth.token.email
        && request.resource.data.campusId == campus()
        && request.resource.data.status == 'active' && request.resource.data.createdAt == request.time;
      allow update: if student() && resource.data.sellerUid == request.auth.uid
        && resource.data.campusId == campus() && validListing(request.resource.data)
        && resource.data.status in ['active','reserved']
        && request.resource.data.status in ['active','reserved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','price','category','condition','images','imageIds','status']);
      allow delete: if student() && resource.data.sellerUid == request.auth.uid
        && resource.data.campusId == campus() && resource.data.status in ['active','reserved'];
    }
    match /conversations/{conversationId} {
      allow read: if student() && request.auth.uid in resource.data.participants;
      allow create: if false; // Authenticated backend validates and deduplicates conversations.
      // Message previews/notifications are backend-owned to prevent forged events.
      allow update, delete: if false;
      match /messages/{messageId} {
        allow read: if member(conversationId);
        allow create: if false; // Backend atomically writes message, preview and notification.
        allow update, delete: if false;
      }
    }
    match /notifications/{notificationId} {
      allow read: if student() && resource.data.userId == request.auth.uid;
      allow update: if student() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }
    match /transactions/{transactionId} {
      allow read: if student() && (resource.data.sellerUid == request.auth.uid || resource.data.buyerUid == request.auth.uid);
      allow write: if false;
    }
    // Upload registry and distributed budgets are backend-owned. Rules may read
    // registry entries to validate listing photos; clients cannot forge them.
    match /media/{id} { allow read, write: if false; }
    match /uploadLimits/{id} { allow read, write: if false; }
    match /moderationAccounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /moderators/{uid} { allow read, write: if false; }
    match /reports/{id} { allow read, write: if false; }
    match /removedListings/{id} { allow read, write: if false; }
    match /moderationEvents/{id} { allow read, write: if false; }
    match /openReports/{id} { allow read, write: if false; }
    match /reportLimits/{uid} { allow read, write: if false; }
    // Blocks are API-only, including reads. The other party cannot enumerate them.
    match /users/{uid}/blocks/{targetUid} { allow read, write: if false; }
    // All other paths (including legacy /messages) are denied by default.
  }
}
