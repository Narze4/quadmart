# Cloud development only. Register a web app in quadmart-development for actual values.
# Do not copy production configuration here.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=quadmart-development
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-development-web-app-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=quadmart-development.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-development-web-app-id
FIREBASE_ADMIN_PROJECT_ID=quadmart-development
# Use server-side Application Default Credentials, never NEXT_PUBLIC credentials.
# Local emulator setup uses npm run dev:local instead of this template.
# Vercel Preview only: short-lived federation; these identifiers are not secrets.
QUADMART_CREDENTIAL_MODE=vercel-oidc
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/377519547132/locations/global/workloadIdentityPools/quadmart-preview/providers/vercel
GCP_SERVICE_ACCOUNT_EMAIL=quadmart-preview@quadmart-development.iam.gserviceaccount.com
# Enable only after adding the server-only Cloudinary credentials below.
QUADMART_ENABLE_UPLOADS=false
# Firebase Admin 14 requires ESM loading from CommonJS on Vercel.
NODE_OPTIONS=--experimental-require-module

# Stable authorized domain used by Firebase verification links.
NEXT_PUBLIC_APP_URL=https://quadmart-git-security-firestore-rules-narze4s-projects.vercel.app
# Keep false until the Enterprise provider is registered and hosted checks pass.
# Authentication enforcement is a separate Firebase console setting.
NEXT_PUBLIC_ENABLE_APP_CHECK=false
# Public site identifier (not a server secret); restrict it to the preview host.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Server only. Use a dedicated development key with access only to
# quadmart/quadmart-development (or a separate product environment).
# The configured key uses Media Library User plus that folder's Manager role.
CLOUDINARY_CLOUD_NAME=replace-with-development-cloud-name
CLOUDINARY_API_KEY=replace-with-development-key
CLOUDINARY_API_SECRET=replace-with-development-secret
